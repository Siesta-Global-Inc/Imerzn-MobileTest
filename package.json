{
  "name": "imerzn-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright end-to-end test framework",
  "scripts": {
    "mobile:emulator": "node scripts/mobile-start-emulator.mjs",
    "mobile:test": "wdio run mobile-wdio.conf.ts",
    "mobile:login": "wdio run mobile-wdio.conf.ts --spec tests/auth/mobile-login.spec.ts",
    "mobile:signup": "wdio run mobile-wdio.conf.ts --spec tests/auth/mobile-traveler-signup.spec.ts",
    "mobile:localite-signup": "wdio run mobile-wdio.conf.ts --spec tests/auth/mobile-localite-signup-and-verify.spec.ts",
    "mobile:typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.8.3",
    "webdriverio": "^10.1.0"
  }
}
