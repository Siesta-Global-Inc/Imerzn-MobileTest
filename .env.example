# Copy this file to .env and change the values for your machine.
# config/mobile-env.ts reads these settings.

# Admin portal, used by the localite signup test (default https://dev.admin.imerzn.com).
ADMIN_BASE_URL=https://dev.admin.imerzn.com

# Signup tests create real accounts (and may send an SMS); they run only when this is true.
RUN_SIGNUP_TEST=false

# true hides the admin portal browser in the localite signup test.
MOBILE_ADMIN_HEADLESS=false

# adb id of the device to use when several are connected (e.g. emulator-5554). Optional.
# MOBILE_UDID=

# AVD name: when set, Appium starts that emulator itself (slow). Leave empty to use the emulator
# started with `npm run mobile:emulator` or a USB phone.
# MOBILE_AVD=
