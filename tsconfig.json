{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "expect-webdriverio"],
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Short import paths, e.g. '@pages/auth/mobile-login-page'.
    // WebdriverIO reads these aliases from this file (tsConfigPath in mobile-wdio.conf.ts).
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@data/*": ["data/*"],
      "@helpers/*": ["helpers/*"],
      "@pages/*": ["pages/*"]
    }
  },
  "include": [
    "mobile-wdio.conf.ts",
    "config/**/*.ts",
    "data/**/*.ts",
    "helpers/**/*.ts",
    "pages/**/*.ts",
    "tests/**/*.ts"
  ]
}
